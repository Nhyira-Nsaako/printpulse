# ── Database ──────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./printpulse.db

# ── JWT Auth ───────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── MQTT Broker ────────────────────────────────────────
MQTT_BROKER=152fa86b7709460f8c860cd2732d9920.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=PrintPulse
MQTT_PASSWORD=FinalYearProject@2026
MQTT_TOPIC=printpulse/sensor/data

# ── Email Alerts (SMTP) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_FROM_EMAIL=your@gmail.com

# ── SMS Alerts (Twilio) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# ── Alert Thresholds ───────────────────────────────────
# Minimum confidence (0.0–1.0) to trigger an alert
ALERT_CONFIDENCE_THRESHOLD=0.85
# Fault classes that trigger alerts (comma-separated)
ALERT_FAULT_CLASSES=NOZZLE_CLOG,MOTOR_FAULT,THERMAL_RUNAWAY
