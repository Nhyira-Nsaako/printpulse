# Only needed for production builds where the frontend and backend are on
# different domains (e.g. frontend on Vercel, backend on Railway). Leave
# unset for local dev — Vite's dev-server proxy and localhost:8000 defaults
# in src/config.ts already handle that case.

VITE_API_URL=https://your-backend.up.railway.app/api
VITE_WS_URL=wss://your-backend.up.railway.app
